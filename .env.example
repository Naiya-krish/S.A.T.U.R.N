# ───────────────────────────────────────────────────────────────
# S.A.T.U.R.N. — environment template. Copy to .env (never commit .env)
# ───────────────────────────────────────────────────────────────

# --- Backend ---------------------------------------------------
SATURN_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
# Comma separated list of allowed browser origins (dev default shown)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Vertex AI (Google Gen AI SDK) -----------------------------
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
# Leave these blank to run the agent in DETERMINISTIC MOCK mode.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# Set to 1 to force mock mode even when credentials exist
SATURN_FORCE_MOCK_LLM=0

# --- Data providers --------------------------------------------
# Nominatim asks for a descriptive User-Agent with a contact address.
NOMINATIM_USER_AGENT=saturn-geoai/0.1 (+https://github.com/saturn-geoai)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_S=1.0
# Optional: set to allow NASA FIRMS fire detections (never commit the real key)
FIRMS_MAP_KEY=

# --- Auth & saved data (Phase 8) -------------------------------
# '' = auto: Firebase when GOOGLE_CLOUD_PROJECT is set, otherwise a safe
#      public demo (no accounts; saved data is shared and labelled as such).
# 'disabled' = reject protected routes entirely.
SATURN_AUTH=
FIREBASE_ENABLED=true
FIRESTORE_PREFIX=saturn

# --- Rate limiting ---------------------------------------------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- Frontend (Vite, exposed to browser — no secrets here) -----
VITE_API_BASE=/api
VITE_WAKE_WORD_ENABLED=0
VITE_ENABLE_LOADER=1

# Firebase web config (PUBLIC by design: identifies the project, authorises
# nothing). Leave blank to run without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
